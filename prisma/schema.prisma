generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model option {
  id         Int      @id @default(autoincrement())
  text       String
  questionId Int
  order      Int
  question   question @relation(fields: [questionId], references: [id], map: "Option_questionId_fkey")

  @@index([questionId], map: "Option_questionId_fkey")
}

model question {
  id       Int      @id @default(autoincrement())
  typeId   Int
  order    Int
  text     String
  surveyId Int
  option   option[]
  survey   survey   @relation(fields: [surveyId], references: [id], map: "Question_surveyId_fkey")
  type     type     @relation(fields: [typeId], references: [id], map: "Question_typeId_fkey")

  @@index([surveyId], map: "Question_surveyId_fkey")
  @@index([typeId], map: "Question_typeId_fkey")
}

model status {
  id     Int      @id @default(autoincrement())
  name   String   @unique(map: "Status_name_key")
  survey survey[]
}

model survey {
  id          Int        @id @default(autoincrement())
  name        String
  description String
  statusId    Int
  authorId    Int
  question    question[]
  user        user       @relation(fields: [authorId], references: [id], map: "Survey_authorId_fkey")
  status      status     @relation(fields: [statusId], references: [id], map: "Survey_statusId_fkey")
  vote        vote[]

  @@index([authorId], map: "Survey_authorId_fkey")
  @@index([statusId], map: "Survey_statusId_fkey")
}

model type {
  id       Int        @id @default(autoincrement())
  name     String     @unique(map: "Type_name_key")
  question question[]
}

model user {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique(map: "User_email_key")
  password String
  roleId   Int      @default(1)
  survey   survey[]
  vote     vote[]
}

model vote {
  id       Int    @id @default(autoincrement())
  answer   String @db.LongText
  surveyId Int
  userId   Int
  survey   survey @relation(fields: [surveyId], references: [id], map: "Vote_surveyId_fkey")
  user     user   @relation(fields: [userId], references: [id], map: "Vote_userId_fkey")

  @@unique([surveyId, userId], map: "Vote_surveyId_userId_key")
  @@index([userId], map: "Vote_userId_fkey")
}
